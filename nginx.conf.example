# Пример конфигурации Nginx (server block) для dl.q0wqex.ru
# Nginx работает на хосте / в Docker с network_mode: host и проксирует запросы на 127.0.0.1:8080

server {
    listen 80;
    listen [::]:80;
    server_name dl.q0wqex.ru;

    # Редирект с HTTP на HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name dl.q0wqex.ru;

    # SSL сертификаты (Let's Encrypt / Certbot)
    ssl_certificate /etc/letsencrypt/live/dl.q0wqex.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dl.q0wqex.ru/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # Максимальный размер загружаемого контента (соответствует MAX_FILE_SIZE)
    client_max_body_size 5000M;

    location / {
        proxy_pass http://127.0.0.1:8080;
        
        # HTTP/1.1 и отключение буферизации для прямой передачи файлов и Server-Sent Events (SSE)
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_request_buffering off;

        # Заголовки проксирования
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Таймауты для больших файлов и длительных загрузок
        proxy_connect_timeout 60s;
        proxy_send_timeout 1800s;
        proxy_read_timeout 1800s;
    }
}
